# API Configuration
REACT_APP_API_BASE_URL=http://localhost:5090

# Public Path (for Module Federation)
# Use 'auto' for automatic detection or specify full URL
REACT_APP_PUBLIC_PATH=auto

# Host App Origin (for postMessage security)
# Use '*' in development, specific origin in production
REACT_APP_HOST_ORIGIN=*

# Force Mode (development only)
# Values: standalone | embedded
# REACT_APP_FORCE_MODE=standalone

# Development Tools
# Enable dev tools panel in development mode
REACT_APP_ENABLE_DEV_TOOLS=true