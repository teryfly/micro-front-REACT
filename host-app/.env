REACT_APP_CONFIG_URL=/apps-config.json
REACT_APP_PUBLIC_PATH=./
REACT_APP_ENV=development

# ===== 单点登录（OAuth2 授权码模式）=====
# 是否启用单点登录，本地无认证中心时可设为 false（使用本地模拟用户）
REACT_APP_SSO_ENABLED=true
# 认证中心地址
REACT_APP_SSO_BASE_URL=http://192.168.120.237:31000
# 注册的客户端 id / 密钥 / 权限范围
REACT_APP_SSO_CLIENT_ID=schedule
REACT_APP_SSO_CLIENT_SECRET=20ecf18bff34469188368d1ab2ff1be9
REACT_APP_SSO_SCOPE=openid profile phone role workno identityapi oauthapi basicapi resource-pool-api schedule-api isp-scheduler-api fhirapi applicationform-api patient-portal-api logging-router-api
# 注册的登录成功回跳地址，留空则取当前站点 origin（推荐留空，自动跟随 localhost / IP / 域名）
REACT_APP_SSO_REDIRECT_URI=
# 登出后回跳地址，留空则取当前站点 origin（推荐留空，自动跟随访问地址）
REACT_APP_SSO_POST_LOGOUT_REDIRECT_URI=
# 可选：后端令牌代理地址，配置后由后端用 code 换令牌（避免前端暴露 client_secret / 规避跨域）
REACT_APP_SSO_TOKEN_PROXY_URL=
# 无登录态时是否自动跳转认证中心
REACT_APP_SSO_AUTO_LOGIN=true
# 登录后是否调用 /connect/userinfo 获取用户信息
REACT_APP_SSO_FETCH_USERINFO=true
# 接口返回 403 时是否重新走一次单点登录
REACT_APP_SSO_RELOGIN_ON_FORBIDDEN=true
